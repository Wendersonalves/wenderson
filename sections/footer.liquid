{% comment %} Footer - CW Games {% endcomment %}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__top">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-col--brand">
          <a href="/" class="footer-logo">
            {% if section.settings.logo %}
              <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" width="160" loading="lazy">
            {% else %}
              <div class="site-header__logo-text"><span class="logo-cw">CW</span><span class="logo-games">GAMES</span></div>
            {% endif %}
          </a>
          <p class="footer-tagline">{{ section.settings.tagline | default: 'Sua loja especializada em jogos, consoles e acessórios para toda a família de gamers!' }}</p>
          <div class="footer-social">
            {% if section.settings.instagram_url %}<a href="{{ section.settings.instagram_url }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>{% endif %}
            {% if section.settings.facebook_url %}<a href="{{ section.settings.facebook_url }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>{% endif %}
            {% if section.settings.whatsapp_url %}<a href="{{ section.settings.whatsapp_url }}" class="social-link" aria-label="WhatsApp" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg></a>{% endif %}
            {% if section.settings.youtube_url %}<a href="{{ section.settings.youtube_url }}" class="social-link" aria-label="YouTube" target="_blank" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg></a>{% endif %}
          </div>
        </div>
        <div class="footer-col">
          <h4 class="footer-col__title">Loja</h4>
          <ul class="footer-links">
            <li><a href="/collections/all">Todos os Produtos</a></li>
            <li><a href="/collections/lancamentos">Lançamentos</a></li>
            <li><a href="/collections/usados">Produtos Usados</a></li>
            <li><a href="/collections/retro">Retrô</a></li>
            <li><a href="/pages/ofertas">Ofertas</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-col__title">Categorias</h4>
          <ul class="footer-links">
            <li><a href="/collections/jogos">Jogos</a></li>
            <li><a href="/collections/consoles">Consoles</a></li>
            <li><a href="/collections/controles">Controles</a></li>
            <li><a href="/collections/acessorios">Acessórios</a></li>
            <li><a href="/collections/headsets">Headsets</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-col__title">Ajuda</h4>
          <ul class="footer-links">
            <li><a href="/pages/faq">Perguntas Frequentes</a></li>
            <li><a href="/pages/entrega">Entrega &amp; Frete</a></li>
            <li><a href="/pages/trocas">Trocas &amp; Devoluções</a></li>
            <li><a href="/pages/garantia">Garantia</a></li>
            <li><a href="/pages/contato">Contato</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-col__title">Contato</h4>
          <ul class="footer-contact">
            {% if section.settings.phone %}<li><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6 19.79 19.79 0 0 1 1.58 5.07 2 2 0 0 1 3.55 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.91a16 16 0 0 0 6.08 6.08l1.07-.88a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg><a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a></li>{% endif %}
            {% if section.settings.email %}<li><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>{% endif %}
            {% if section.settings.address %}<li><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{{ section.settings.address }}</span></li>{% endif %}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="container">
      <div class="footer-bottom__inner">
        <p class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.{% if section.settings.cnpj %} CNPJ: {{ section.settings.cnpj }}{% endif %}</p>
        <div class="footer-legal-links">
          <a href="/policies/privacy-policy">Privacidade</a>
          <a href="/policies/terms-of-service">Termos de Uso</a>
          <a href="/policies/refund-policy">Reembolsos</a>
        </div>
        <div class="footer-payment">
          <span class="footer-payment__label">Pagamentos:</span>
          <div class="footer-payment__icons">
            <span class="payment-badge">Pix</span>
            <span class="payment-badge">Boleto</span>
            <span class="payment-badge">Visa</span>
            <span class="payment-badge">Master</span>
            <span class="payment-badge">Amex</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<a href="{{ section.settings.whatsapp_url | default: '#' }}" class="whatsapp-float" target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
  <span>WhatsApp</span>
</a>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo"},
    {"type":"textarea","id":"tagline","label":"Slogan","default":"Sua loja especializada em jogos, consoles e acessórios!"},
    {"type":"text","id":"phone","label":"Telefone"},
    {"type":"text","id":"email","label":"E-mail"},
    {"type":"text","id":"address","label":"Endereço"},
    {"type":"text","id":"cnpj","label":"CNPJ"},
    {"type":"url","id":"instagram_url","label":"Instagram"},
    {"type":"url","id":"facebook_url","label":"Facebook"},
    {"type":"url","id":"whatsapp_url","label":"WhatsApp"},
    {"type":"url","id":"youtube_url","label":"YouTube"}
  ]
}
{% endschema %}

{% comment %} Promo Banner - CW Games {% endcomment %}
<section class="promo-banner">
  <div class="promo-banner__inner">
    {% for block in section.blocks %}
      {% if block.type == 'promo' %}
        <a href="{{ block.settings.url | default: '/collections/all' }}" class="promo-card promo-card--{{ block.settings.style | default: 'blue-gradient' }}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy" class="promo-card__bg-img">{% endif %}
          <div class="promo-card__content">
            {% if block.settings.eyebrow %}<span class="promo-card__eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
            <h3 class="promo-card__title">{{ block.settings.title | default: 'Promoção' }}</h3>
            {% if block.settings.description %}<p class="promo-card__desc">{{ block.settings.description }}</p>{% endif %}
            <span class="promo-card__cta">{{ block.settings.cta | default: 'Ver oferta' }} &rarr;</span>
          </div>
        </a>
      {% endif %}
    {% else %}
      <a href="/collections/lancamentos" class="promo-card promo-card--blue-gradient">
        <div class="promo-card__content">
          <span class="promo-card__eyebrow">Novidade</span>
          <h3 class="promo-card__title">Lançamentos da Semana</h3>
          <p class="promo-card__desc">Confira os títulos mais esperados</p>
          <span class="promo-card__cta">Ver lançamentos &rarr;</span>
        </div>
      </a>
      <a href="/collections/usados" class="promo-card promo-card--dark-blue">
        <div class="promo-card__content">
          <span class="promo-card__eyebrow">Economia</span>
          <h3 class="promo-card__title">Jogos Usados até 60% OFF</h3>
          <p class="promo-card__desc">Qualidade garantida por menos</p>
          <span class="promo-card__cta">Ver usados &rarr;</span>
        </div>
      </a>
      <a href="/collections/retro" class="promo-card promo-card--retro">
        <div class="promo-card__content">
          <span class="promo-card__eyebrow">Nostalgia</span>
          <h3 class="promo-card__title">Vídeo Game Retrô</h3>
          <p class="promo-card__desc">Clássicos que marcaram gerações</p>
          <span class="promo-card__cta">Ver coleção retrô &rarr;</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Banners Promocionais",
  "blocks": [
    {
      "type": "promo","name": "Banner Promo",
      "settings": [
        {"type":"text","id":"eyebrow","label":"Texto pequeno"},
        {"type":"text","id":"title","label":"Título","default":"Promoção"},
        {"type":"text","id":"description","label":"Descrição"},
        {"type":"text","id":"cta","label":"Texto do link","default":"Ver oferta"},
        {"type":"url","id":"url","label":"Link"},
        {"type":"image_picker","id":"image","label":"Imagem"},
        {"type":"select","id":"style","label":"Estilo","options":[
          {"value":"blue-gradient","label":"Gradiente Azul"},
          {"value":"dark-blue","label":"Azul Escuro"},
          {"value":"retro","label":"Retrô"},
          {"value":"sale","label":"Promoção"}
        ],"default":"blue-gradient"}
      ]
    }
  ],
  "presets": [{"name": "Banners Promocionais"}]
}
{% endschema %}

{% comment %} Generic Page - CW Games {% endcomment %}

<div class="page-content section-padding">
  <div class="container container--narrow">
    <h1 class="page-content__title">{{ page.title }}</h1>
    <div class="rte page-content__body">{{ page.content }}</div>
  </div>
</div>

<style>
.container--narrow { max-width: 860px; }
.page-content__title { font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.5rem); font-weight: 700; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 3px solid var(--blue-100); }
.page-content__body h2 { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; margin: 28px 0 12px; color: var(--gray-900); }
.page-content__body h3 { font-size: 1.1rem; font-weight: 700; margin: 20px 0 8px; color: var(--gray-800); }
</style>

{% comment %} Cart Page - CW Games {% endcomment %}

<div class="cart-page section-padding">
  <div class="container">
    <h1 class="cart-page__title">Meu Carrinho</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-page__layout">
        <div class="cart-page__items">
          <form action="/cart" method="post" id="cart-form">
            {% for item in cart.items %}
              <div class="cart-item" data-item-key="{{ item.key }}">
                <a href="{{ item.url }}" class="cart-item__img-link">
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | default: item.title | escape }}" width="80" height="80" loading="lazy" class="cart-item__img">
                </a>
                <div class="cart-item__details">
                  <p class="cart-item__vendor">{{ item.vendor }}</p>
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product_title }}</a>
                  {% unless item.variant_title == 'Default Title' %}
                    <p class="cart-item__variant">{{ item.variant_title }}</p>
                  {% endunless %}
                  <div class="cart-item__bottom">
                    <div class="qty-selector qty-selector--sm">
                      <button type="button" class="qty-btn cart-qty-minus" data-key="{{ item.key }}">&#8722;</button>
                      <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="qty-input cart-qty-input" data-key="{{ item.key }}">
                      <button type="button" class="qty-btn cart-qty-plus" data-key="{{ item.key }}">+</button>
                    </div>
                    <button type="button" class="cart-item__remove" data-key="{{ item.key }}" aria-label="Remover {{ item.product_title }}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                      Remover
                    </button>
                  </div>
                </div>
                <div class="cart-item__price">
                  {% if item.original_price > item.final_price %}
                    <span class="cart-item__price-original">{{ item.original_line_price | money }}</span>
                  {% endif %}
                  <span class="cart-item__price-final">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            {% endfor %}
          </form>
        </div>

        <div class="cart-page__summary">
          <div class="cart-summary">
            <h2 class="cart-summary__title">Resumo do Pedido</h2>
            <div class="cart-summary__lines">
              <div class="cart-summary__line">
                <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %})</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
              {% if cart.total_price >= 29900 %}
                <div class="cart-summary__line cart-summary__line--green">
                  <span>Frete</span>
                  <span>GRÁTIS</span>
                </div>
              {% else %}
                <div class="cart-summary__line">
                  <span>Frete</span>
                  <span>Calculado no checkout</span>
                </div>
                <p class="cart-summary__shipping-note">Frete grátis acima de R$299,00</p>
              {% endif %}
            </div>
            <div class="cart-summary__total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-summary__installment">ou 12x de {{ cart.total_price | divided_by: 12 | money }} sem juros</p>
            <a href="/checkout" class="btn btn--primary cart-summary__checkout">
              Finalizar Compra
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <a href="/collections/all" class="cart-summary__continue">← Continuar comprando</a>
          </div>
        </div>
      </div>
    {% else %}
      <div class="cart-empty">
        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2>Seu carrinho está vazio</h2>
        <p>Explore nossa loja e adicione produtos incríveis!</p>
        <a href="/collections/all" class="btn btn--primary">Explorar produtos</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
.cart-page__title { font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; margin-bottom: 32px; }
.cart-page__layout { display: grid; grid-template-columns: 1fr 360px; gap: 32px; align-items: start; }
.cart-item { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid var(--gray-100); }
.cart-item__img-link { flex-shrink: 0; }
.cart-item__img { width: 80px; height: 80px; object-fit: contain; background: var(--gray-100); border-radius: var(--radius-md); padding: 4px; }
.cart-item__vendor { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--blue-600); }
.cart-item__title { font-size: .95rem; font-weight: 700; color: var(--gray-800); margin-bottom: 4px; display: block; }
.cart-item__title:hover { color: var(--blue-700); }
.cart-item__variant { font-size: .8rem; color: var(--gray-500); margin-bottom: 12px; }
.cart-item__bottom { display: flex; align-items: center; gap: 16px; }
.qty-selector--sm .qty-btn { width: 32px; height: 34px; font-size: 1rem; }
.qty-selector--sm .qty-input { width: 44px; height: 34px; font-size: .9rem; }
.cart-item__remove { display: flex; align-items: center; gap: 4px; font-size: .78rem; font-weight: 600; color: var(--gray-400); transition: color var(--transition); }
.cart-item__remove:hover { color: var(--red-500); }
.cart-item__price { text-align: right; }
.cart-item__price-original { font-size: .8rem; color: var(--gray-400); text-decoration: line-through; display: block; }
.cart-item__price-final { font-size: 1.05rem; font-weight: 800; color: var(--gray-900); }
.cart-summary { background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-xl); padding: 28px; position: sticky; top: calc(var(--header-h) + 20px); }
.cart-summary__title { font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; }
.cart-summary__lines { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--gray-200); }
.cart-summary__line { display: flex; justify-content: space-between; font-size: .88rem; color: var(--gray-600); }
.cart-summary__line--green { color: var(--green-500); font-weight: 700; }
.cart-summary__shipping-note { font-size: .78rem; color: var(--blue-600); background: var(--blue-50); padding: 8px 12px; border-radius: var(--radius-md); margin-top: -4px; }
.cart-summary__total { display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 800; color: var(--gray-900); margin-bottom: 6px; }
.cart-summary__installment { font-size: .82rem; color: var(--gray-500); text-align: right; margin-bottom: 20px; }
.cart-summary__checkout { width: 100%; justify-content: center; padding: 14px; font-size: .95rem; border-radius: var(--radius-lg); }
.cart-summary__continue { display: block; text-align: center; margin-top: 12px; font-size: .85rem; font-weight: 600; color: var(--gray-500); transition: color var(--transition); }
.cart-summary__continue:hover { color: var(--blue-700); }
.cart-empty { text-align: center; padding: 80px 20px; color: var(--gray-500); display: flex; flex-direction: column; align-items: center; gap: 16px; }
.cart-empty h2 { font-size: 1.4rem; font-weight: 700; color: var(--gray-700); }
@media (max-width: 768px) {
  .cart-page__layout { grid-template-columns: 1fr; }
  .cart-item { grid-template-columns: auto 1fr; }
  .cart-item__price { grid-column: 2; text-align: left; }
}
</style>
